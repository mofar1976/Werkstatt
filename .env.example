# Copy to .env and adjust. Used by docker compose and the API.

# --- Database (MongoDB) ---
# Single-node replica set (rs0) in Docker on port 27018 (27017 is often taken by
# a local MongoDB). The replica set is required for multi-document transactions.
MONGODB_URI="mongodb://localhost:27018/car_garage?replicaSet=rs0"

# --- API (apps/api) ---
NODE_ENV=development
API_PORT=4000
# Comma-separated list of allowed CORS origins (the three Angular apps).
WEB_ORIGIN="http://localhost:4200,http://localhost:4300,http://localhost:4400"

# --- Auth ---
JWT_ACCESS_SECRET="dev-access-secret-change-me-please"
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_DAYS=30
BCRYPT_ROUNDS=10

# --- Object storage (MinIO / S3) ---
S3_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_ACCESS_KEY="minioadmin"
S3_SECRET_KEY="minioadmin"
S3_BUCKET="car-garage"
S3_FORCE_PATH_STYLE=true
# Base URL objects are served from. Leave unset in dev (defaults to
# ${S3_ENDPOINT}/${S3_BUCKET}); set to a CDN/public host in production.
# S3_PUBLIC_URL="https://cdn.example.com/car-garage"

# --- Web (apps/web) ---
# Angular apps read the API URL from src/environments/*; this is only a reference.
# backoffice -> http://localhost:4200
# customer   -> http://localhost:4300
# workshop   -> http://localhost:4400
API_URL="http://localhost:4000"
